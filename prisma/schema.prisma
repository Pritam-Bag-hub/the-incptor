datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  LANDOWNER
  WORKER
  ADMIN
}

model User {
  id                 String    @id @default(uuid())
  name               String
  phone              String    @unique
  role               Role
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  lands              Land[]
  demands            BuyerDemand[]
  buyerContracts     Contract[] @relation("BuyerContracts")
  landownerContracts Contract[] @relation("LandownerContracts")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum LandStatus {
  AVAILABLE
  UNAVAILABLE
  UNDER_CONTRACT
}

enum SizeUnit {
  ACRE
  HECTARE
}

model CropCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  crops       Crop[]
}

model Crop {
  id           String       @id @default(uuid())
  name         String       @unique
  categoryId   String
  category     CropCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  durationDays Int
  description  String?
  metadataJson String?      // Mappings for future timelines & workers
  demands      BuyerDemand[]
  contracts    Contract[]
  milestoneTemplates CropMilestoneTemplate[]
}

model Land {
  id          String     @id @default(uuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  size        Float
  unit        SizeUnit
  address     String
  village     String
  district    String
  state       String
  pincode     String?
  latitude    Float
  longitude   Float
  status      LandStatus @default(AVAILABLE)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  selections  DemandLandSelection[]
  contracts   Contract[]

  @@index([ownerId])
}

enum BuyerDemandStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum QuantityUnit {
  KG
  QUINTAL
  TONNE
}

model BuyerDemand {
  id                  String            @id @default(uuid())
  buyerId             String
  buyer               User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cropId              String
  crop                Crop              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  requiredQuantity    Float
  quantityUnit        QuantityUnit
  preferredState      String
  preferredDistrict   String?
  preferredLatitude   Float?
  preferredLongitude  Float?
  searchRadiusKm      Float?
  requiredLandArea    Float?
  preferredStartDate  DateTime?
  expectedHarvestDate DateTime?
  status              BuyerDemandStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  selectedLands       DemandLandSelection[]
  contracts           Contract[]

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
}

model DemandLandSelection {
  id        String      @id @default(uuid())
  demandId  String
  demand    BuyerDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  landId    String
  land      Land        @relation(fields: [landId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([demandId, landId])
  @@index([demandId])
  @@index([landId])
}

enum ContractStatus {
  PENDING_APPROVAL
  ACCEPTED
  ACTIVE
  REJECTED
  CANCELLED
  COMPLETED
}

model Contract {
  id                  String         @id @default(uuid())
  demandId            String
  demand              BuyerDemand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  landId              String
  land                Land           @relation(fields: [landId], references: [id], onDelete: Cascade)
  buyerId             String
  buyer               User           @relation("BuyerContracts", fields: [buyerId], references: [id], onDelete: Cascade)
  landownerId         String
  landowner           User           @relation("LandownerContracts", fields: [landownerId], references: [id], onDelete: Cascade)
  cropId              String
  crop                Crop           @relation(fields: [cropId], references: [id], onDelete: Cascade)
  
  landArea            Float
  allocatedQuantity   Float
  proposedPrice       Float
  startDate           DateTime
  expectedHarvestDate DateTime
  
  status              ContractStatus @default(PENDING_APPROVAL)
  notes               String?
  rejectionReason     String?
  revision            Int            @default(1)
  
  decisionDate        DateTime?
  activatedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  history             ContractHistory[]
  progressUpdates     FarmProgress[]
  financialAllocation ContractFinancialAllocation?
  yield               ContractYield?
  milestones          ContractMilestone[]
  alerts              ContractAlert[]
  tasks               ContractTask[]

  @@unique([demandId, landId])
  @@index([demandId])
  @@index([landId])
  @@index([buyerId])
  @@index([landownerId])
  @@index([status])
}

model ContractHistory {
  id                  String         @id @default(uuid())
  contractId          String
  contract            Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)

  revision            Int

  landArea            Float
  allocatedQuantity   Float
  proposedPrice       Float

  startDate           DateTime
  expectedHarvestDate DateTime

  status              ContractStatus

  notes               String?
  rejectionReason     String?

  decisionDate        DateTime?
  activatedAt         DateTime?
  completedAt         DateTime?

  createdAt           DateTime       @default(now())

  @@index([contractId])
}

enum FarmProgressStage {
  LAND_PREPARATION
  SOWING
  GROWING
  HARVEST_READY
  HARVEST_COMPLETED
}

model FarmProgress {
  id          String            @id @default(uuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stage       FarmProgressStage
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([contractId])
  @@index([stage])
}

enum FulfillmentStatus {
  PENDING
  PARTIAL
  FULFILLED
  OVERFULFILLED
}

model ContractFinancialAllocation {
  id                 String   @id @default(uuid())
  contractId         String   @unique
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  totalContractValue Float
  landownerAmount    Float
  workforceBudget    Float
  logisticsBudget    Float
  platformFee        Float
  reserveBudget      Float
  currency           String   @default("INR")
  isConfigured       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ContractYield {
  id                    String            @id @default(uuid())
  contractId            String            @unique
  contract              Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  estimatedQuantity     Float?
  actualQuantity        Float?
  unit                  QuantityUnit
  fulfillmentPercentage Float?
  fulfillmentStatus     FulfillmentStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model CropMilestoneTemplate {
  id                      String   @id @default(uuid())
  cropId                  String
  crop                    Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  title                   String
  sequence                Int
  recommendedDurationDays Int?
  durationPercentage      Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([cropId, sequence])
  @@index([cropId])
}

model ContractMilestone {
  id          String          @id @default(uuid())
  contractId  String
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  sequence    Int
  plannedDate DateTime
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       ContractTask[]

  @@unique([contractId, sequence])
  @@index([contractId])
  @@index([status])
}

enum ContractAlertType {
  MILESTONE_OVERDUE
  HARVEST_DELAY
  PROGRESS_DELAY
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model ContractAlert {
  id          String            @id @default(uuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId String?
  type        ContractAlertType
  severity    AlertSeverity
  title       String
  message     String
  isRead      Boolean           @default(false)
  isResolved  Boolean           @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([contractId, type, title]) // Uniqueness helper: prevents multiple active/inactive duplicates of same type + title on same contract
  @@index([contractId])
  @@index([type])
  @@index([isResolved])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ContractTask {
  id                 String            @id @default(uuid())
  contractId         String
  contract           Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId        String
  milestone          ContractMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  sequence           Int
  plannedStart       DateTime?
  dueDate            DateTime?
  priority           TaskPriority      @default(MEDIUM)
  status             TaskStatus        @default(PENDING)
  estimatedWorkHours Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([milestoneId, sequence])
  @@index([contractId])
  @@index([milestoneId])
  @@index([status])
}

