datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  LANDOWNER
  WORKER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  lands     Land[]
  demands   BuyerDemand[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum LandStatus {
  AVAILABLE
  UNAVAILABLE
  UNDER_CONTRACT
}

enum SizeUnit {
  ACRE
  HECTARE
}

model CropCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  crops       Crop[]
}

model Crop {
  id           String       @id @default(uuid())
  name         String       @unique
  categoryId   String
  category     CropCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  durationDays Int
  description  String?
  metadataJson String?      // Mappings for future timelines & workers
  demands      BuyerDemand[]
}

model Land {
  id          String     @id @default(uuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  size        Float
  unit        SizeUnit
  address     String
  village     String
  district    String
  state       String
  pincode     String?
  latitude    Float
  longitude   Float
  status      LandStatus @default(AVAILABLE)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

enum BuyerDemandStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum QuantityUnit {
  KG
  QUINTAL
  TONNE
}

model BuyerDemand {
  id                  String            @id @default(uuid())
  buyerId             String
  buyer               User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cropId              String
  crop                Crop              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  requiredQuantity    Float
  quantityUnit        QuantityUnit
  preferredState      String
  preferredDistrict   String?
  preferredLatitude   Float?
  preferredLongitude  Float?
  searchRadiusKm      Float?
  requiredLandArea    Float?
  preferredStartDate  DateTime?
  expectedHarvestDate DateTime?
  status              BuyerDemandStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
}
